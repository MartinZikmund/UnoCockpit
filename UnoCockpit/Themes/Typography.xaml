<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Inter (SIL OFL). Inter.ttf.manifest maps Light/Regular/SemiBold to the static files. -->
  <FontFamily x:Key="CockpitFontFamily">ms-appx:///Assets/Fonts/Inter.ttf</FontFamily>

  <Style x:Key="CockpitTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource CockpitFontFamily}" />
    <Setter Property="Foreground" Value="{ThemeResource CockpitTextPrimaryBrush}" />
    <Setter Property="FontSize" Value="16" />
  </Style>

  <Style x:Key="CockpitHeroNumberStyle" BasedOn="{StaticResource CockpitTextStyle}" TargetType="TextBlock">
    <Setter Property="FontSize" Value="120" />
    <Setter Property="FontWeight" Value="Light" />
    <Setter Property="LineHeight" Value="120" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

  <Style x:Key="CockpitLargeNumberStyle" BasedOn="{StaticResource CockpitTextStyle}" TargetType="TextBlock">
    <Setter Property="FontSize" Value="72" />
    <Setter Property="FontWeight" Value="Light" />
  </Style>

  <Style x:Key="CockpitTitleStyle" BasedOn="{StaticResource CockpitTextStyle}" TargetType="TextBlock">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="CockpitValueStyle" BasedOn="{StaticResource CockpitTextStyle}" TargetType="TextBlock">
    <Setter Property="FontSize" Value="32" />
  </Style>

  <Style x:Key="CockpitLabelStyle" BasedOn="{StaticResource CockpitTextStyle}" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource CockpitTextSecondaryBrush}" />
  </Style>

  <Style x:Key="CockpitBodyStyle" BasedOn="{StaticResource CockpitTextStyle}" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource CockpitTextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="CockpitStatusTextStyle" BasedOn="{StaticResource CockpitTextStyle}" TargetType="TextBlock">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</ResourceDictionary>
