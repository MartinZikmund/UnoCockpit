<Project Sdk="Uno.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\UnoCockpit.Core\UnoCockpit.Core.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFrameworks>net10.0-browserwasm;net10.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Display name -->
    <ApplicationTitle>Uno Cockpit</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>dev.zikmund.unocockpit</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>UnoCockpit</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Sensor-powered car cockpit built with Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Mvvm;
      Skia;
    </UnoFeatures>
  </PropertyGroup>

  <!-- Smaller download for the car: .NET's ICU isn't needed, all formatting is invariant.
       IL trimming stays off: PublishTrimmed breaks Uno 7.0 startup (invalid vtable slot in WebAssemblyWindowWrapper). -->
  <PropertyGroup Condition="$(TargetFramework.Contains('browserwasm')) and '$(Configuration)' == 'Release'">
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Uno's generated App code sets ResourceLoader.DefaultLanguage, which creates a CultureInfo. -->
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp' and $(TargetFramework.Contains('browserwasm'))">
    <EmbeddedResource Include="Platforms\WebAssembly\WasmScripts\cockpit.js" />
  </ItemGroup>

</Project>
