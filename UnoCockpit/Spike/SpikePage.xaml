<Page x:Class="UnoCockpit.Spike.SpikePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:spike="using:UnoCockpit.Spike"
      Background="#111214"
      RequestedTheme="Dark">
  <Grid Padding="24" ColumnSpacing="16" RowSpacing="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.ColumnSpan="2" Spacing="4">
      <TextBlock FontSize="28" FontWeight="SemiBold" Text="Uno Cockpit · car test" />
      <TextBlock x:Name="SummaryText" Foreground="#8A8F98" TextWrapping="Wrap" />
    </StackPanel>

    <!-- (a) Renderer -->
    <Border Grid.Row="1" Padding="16" Background="#1C1D20" CornerRadius="16">
      <Grid RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="FpsText" FontWeight="SemiBold" Text="Renderer" />
        <spike:SpinCanvas x:Name="Spinner" Grid.Row="1" />
      </Grid>
    </Border>

    <!-- (b) GPS -->
    <Border Grid.Row="1" Grid.Column="1" Padding="16" Background="#1C1D20" CornerRadius="16">
      <Grid ColumnSpacing="16" RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock FontWeight="SemiBold" Text="GPS · Uno Geolocator" />
        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="GPS · JS getCurrentPosition" />
        <TextBlock x:Name="UnoGeoText" Grid.Row="1" FontFamily="Consolas" TextWrapping="Wrap" />
        <TextBlock x:Name="JsGeoText" Grid.Row="1" Grid.Column="1" FontFamily="Consolas" TextWrapping="Wrap" />
      </Grid>
    </Border>

    <!-- (c) Gamepad + probe -->
    <Border Grid.Row="2" Padding="16" Background="#1C1D20" CornerRadius="16">
      <ScrollViewer>
        <StackPanel Spacing="8">
          <TextBlock FontWeight="SemiBold" Text="Gamepad (press any button)" />
          <TextBlock x:Name="GamepadText" FontFamily="Consolas" TextWrapping="Wrap" />
          <TextBlock FontWeight="SemiBold" Text="Probe" />
          <TextBlock x:Name="ProbeText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- (d) Camera in a native <video> element, with a XAML button layered over its corner -->
    <Border Grid.Row="2" Grid.Column="1" Padding="16" Background="#1C1D20" CornerRadius="16">
      <Grid RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button x:Name="CameraButton" MinWidth="160" MinHeight="64" Click="OnCameraClick" Content="Start camera" />
          <TextBlock x:Name="CameraText" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1">
          <ContentControl x:Name="VideoHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
          <Button x:Name="OverlayButton"
                  MinWidth="120"
                  MinHeight="64"
                  Margin="8"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Click="OnOverlayClick"
                  Content="Tap me: 0" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Page>
