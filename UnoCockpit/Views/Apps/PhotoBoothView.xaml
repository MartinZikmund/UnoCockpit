<UserControl x:Class="UnoCockpit.Views.Apps.PhotoBoothView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:apps="using:UnoCockpit.Views.Apps"
             xmlns:views="using:UnoCockpit.Views">
  <Border Padding="0" Style="{StaticResource CockpitCardStyle}">
    <Grid>
      <!-- Live preview -->
      <Grid Visibility="{x:Bind apps:PhotoBoothView.Show(ViewModel.IsPreviewing), Mode=OneWay}">
        <views:CameraHost x:Name="Camera" />
        <TextBlock x:Name="CountdownText"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="160"
                   FontWeight="Light"
                   Foreground="White"
                   Style="{StaticResource CockpitTextStyle}" />
        <StackPanel Margin="24" HorizontalAlignment="Center" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="24">
          <Button AutomationProperties.AutomationId="PhotoCancel" Click="OnStop" Content="Cancel" Style="{StaticResource CockpitPillButtonStyle}" />
          <Button AutomationProperties.AutomationId="PhotoShutter"
                  AutomationProperties.Name="Take photo"
                  Click="OnShutter"
                  Style="{StaticResource CockpitAccentPillButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <FontIcon FontSize="22" Foreground="White" Glyph="&#xE722;" />
              <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="White" Text="Snap" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Postcard -->
      <Grid CornerRadius="{StaticResource CockpitCardCornerRadius}" Visibility="{x:Bind apps:PhotoBoothView.Show(ViewModel.HasPostcard), Mode=OneWay}">
        <Image x:Name="PostcardImage" Stretch="UniformToFill" />
        <Border Margin="20" BorderBrush="White" BorderThickness="3" CornerRadius="12" Opacity="0.85" />
        <Border VerticalAlignment="Bottom" Padding="44,28,44,36">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Offset="0" Color="#00000000" />
              <GradientStop Offset="1" Color="#B0000000" />
            </LinearGradientBrush>
          </Border.Background>
          <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock FontSize="34" FontWeight="SemiBold" Foreground="White" Style="{StaticResource CockpitTextStyle}" Text="{x:Bind apps:PhotoBoothView.Place(ViewModel.LastPostcard), Mode=OneWay}" />
              <TextBlock FontSize="18" Foreground="White" Opacity="0.85" Style="{StaticResource CockpitTextStyle}" Text="{x:Bind apps:PhotoBoothView.Stamp(ViewModel.LastPostcard), Mode=OneWay}" />
            </StackPanel>
            <TextBlock Grid.Column="1" VerticalAlignment="Bottom" FontSize="16" FontWeight="SemiBold" Foreground="White" Opacity="0.9" Style="{StaticResource CockpitTextStyle}" Text="Made with Uno Platform" />
          </Grid>
        </Border>
        <Button Margin="36" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.AutomationId="PhotoRetake" Click="OnStart" Content="Retake" Style="{StaticResource CockpitPillButtonStyle}" />
      </Grid>

      <!-- Idle / unavailable -->
      <StackPanel MaxWidth="520"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="16"
                  Visibility="{x:Bind apps:PhotoBoothView.ShowIdle(ViewModel.IsPreviewing, ViewModel.HasPostcard), Mode=OneWay}">
        <FontIcon HorizontalAlignment="Center" FontSize="64" Foreground="{ThemeResource CockpitTextPrimaryBrush}" Glyph="&#xE722;" />
        <TextBlock HorizontalAlignment="Center" Style="{StaticResource CockpitTitleStyle}" Text="Cabin selfie" />
        <TextBlock HorizontalAlignment="Center" HorizontalTextAlignment="Center" Style="{StaticResource CockpitBodyStyle}" Text="{x:Bind apps:PhotoBoothView.StatusText(ViewModel.Status), Mode=OneWay}" />
        <Button Margin="0,8,0,0" HorizontalAlignment="Center" AutomationProperties.AutomationId="PhotoStart" Click="OnStart" Content="Start camera" Style="{StaticResource CockpitAccentPillButtonStyle}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
