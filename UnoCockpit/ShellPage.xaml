<Page x:Class="UnoCockpit.ShellPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#111214"
      RequestedTheme="Dark">
  <StackPanel Padding="24" Spacing="8">
    <TextBlock x:Name="DebugSpeed" AutomationProperties.AutomationId="DebugSpeed" FontSize="48" Text="{x:Bind ViewModel.Trip.SpeedText, Mode=OneWay}" />
    <TextBlock AutomationProperties.AutomationId="DebugDemo" Text="{x:Bind ViewModel.IsDemo, Mode=OneWay}" />
    <TextBlock Text="{x:Bind ViewModel.ParkState, Mode=OneWay}" />
    <TextBlock Text="{x:Bind ViewModel.ClockText, Mode=OneWay}" />
  </StackPanel>
</Page>
